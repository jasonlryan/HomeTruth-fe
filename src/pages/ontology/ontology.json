olumns:minmax(0,1fr) 330px}body:not(.has-details) aside{display:none}.viewport{min-width:0;display:block;position:relative}svg{margin:auto}header{padding:18px 26px}header h1{font-size:25px}header .kind{margin-bottom:6px}.bar{padding:10px 22px;gap:8px}.bar input{width:210px}.edge{opacity:.6;stroke-width:1.4}.edge.active{opacity:1}#zoom{font-size:12px;min-width:75px;color:#526d7b}aside{max-height:100%}@media(max-width:850px){.has-details main{grid-template-columns:minmax(0,1fr)}aside{max-height:350px}}  .node{transition:opacity .18s}.node.dim{opacity:.12}.node.connected rect{fill:#d4eee2;stroke:#12775e;stroke-width:2}.node.selected rect{stroke-width:4}.edge.unrelated{opacity:.07}.foreground-edges,.relationship-labels{pointer-events:none}.foreground-edges .edge.active{stroke-width:3.5;opacity:1}.edge-halo{fill:none;stroke:white;stroke-width:7;stroke-opacity:.9;pointer-events:none}.edge-label-bg{fill:white;fill-opacity:1;stroke:#12775e;stroke-width:1.3}  .label-leader{fill:none;stroke:#526d7b;stroke-width:1.2;stroke-dasharray:3 3;opacity:.75;pointer-events:none}  .foreground-edges path{stroke-linejoin:round}.edgeLabel{font-size:15px}.label-leader{display:none}  .hover-layer{pointer-events:none}.hovering>.background-edges,.hovering>.foreground-edges,.hovering>.relationship-labels{opacity:.08}.hover-layer .edge.active{opacity:1;stroke-width:3.5}.hover-edge-label{font:600 15px system-ui;fill:#173744;paint-order:stroke;stroke:white;stroke-width:5px;stroke-linejoin:round}.interaction-hint{font-size:12px;color:#526d7b} </style></head><body><header><div class=\"kind\">DOMAIN MODEL · CONCEPTS & MEANING</div><h1>HomeTruth / Ontology map</h1><p>Property + people + evidence · Conceptual relationships mapped to the verified local schema · 19 November 2026</p></header><div class=\"bar\"><label for=\"jump\">Concept</label><select id=\"jump\" aria-label=\"Choose concept\"></select><input aria-label=\"Search nodes\" placeholder=\"Search concepts or fields…\"><select aria-label=\"Relationship view\"><option value=\"all\">Overview — show all</option><option value=\"focus\">Focus — selected + neighbours</option></select><button id=\"zout\" aria-label=\"Zoom out\">−</button><button id=\"zin\" aria-label=\"Zoom in\">+</button><button id=\"reset\">Reset</button><button id=\"fit\">Fit to screen</button><output id=\"zoom\" aria-live=\"polite\">Auto fit</output><span class=\"interaction-hint\">Hover to trace · Click to pull connections out · Reset for overview</span><span class=\"pill\">23 concepts · 32 relationships</span></div><main><div class=\"viewport\"><svg role=\"group\" aria-label=\"Interactive concept relationship diagram\"></svg></div><aside><h2>Select a concept</h2><p>Click a node to inspect its relationships and database mapping.</p></aside></main><footer>Solid cards have current table mappings. Dashed cards/lines describe planned or conceptual extensions, not existing tables or database foreign keys. Edge labels are semantic predicates, not cardinality guarantees. Select a concept to inspect the distinction.<br><br>Sources: hometruth-domain-model.md (HT-307), property-people-spine-schema.md (HT-308), agent-sdk-integration.md and the live schema snapshot. Earlier documents contain historical gaps; current implementation status here is based on this snapshot. The registry is a versioned design concept, not a proposed SQL table. External agent access remains roadmap-only.</footer><script>const DATA={\"nodes\": [{\"id\": \"person\", \"title\": \"Person / account\", \"subtitle\": \"users\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"users\"], \"description\": \"Identity; property authority comes from relationships, not a global role.\", \"planned\": false}, {\"id\": \"role\", \"title\": \"Property relationship\", \"subtitle\": \"property_people\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"property_people\"], \"description\": \"Connects a person to a home with role, permissions and validity.\", \"planned\": false}, {\"id\": \"property\", \"title\": \"Property\", \"subtitle\": \"properties\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"properties\"], \"description\": \"Canonical home identity. UPRN may be unknown.\", \"planned\": false}, {\"id\": \"address\", \"title\": \"Property address\", \"subtitle\": \"property_addresses\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"property_addresses\"], \"description\": \"Structured, time-aware addresses. A property may have multiple address records.\", \"planned\": false}, {\"id\": \"document\", \"title\": \"Document\", \"subtitle\": \"userDocuments\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"userDocuments\", \"documents\"], \"description\": \"Personal uploads and system knowledge are separate bounded contexts; these are not duplicate tables.\", \"planned\": false}, {\"id\": \"link\", \"title\": \"Property document\", \"subtitle\": \"property_documents\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"property_documents\"], \"description\": \"Associates a vault document with a home and its scope.\", \"planned\": false}, {\"id\": \"evidence\", \"title\": \"Evidence source\", \"subtitle\": \"evidence_sources\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"evidence_sources\"], \"description\": \"Preserves origin, locator, method and confidence behind a claim.\", \"planned\": false}, {\"id\": \"fact\", \"title\": \"Property fact\", \"subtitle\": \"property_facts\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"property_facts\"], \"description\": \"Time-aware claim with verification status. Currently one nullable evidence_source_id per fact; multi-source support is a future extension.\", \"planned\": false}, {\"id\": \"task\", \"title\": \"Task / reminder\", \"subtitle\": \"property_tasks\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"property_tasks\", \"property_task_status_events\"], \"description\": \"Actions and their status history. Unknown service dates do not automatically mean overdue.\", \"planned\": false}, {\"id\": \"item\", \"title\": \"Physical home item\", \"subtitle\": \"home_items\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"home_items\"], \"description\": \"A particular appliance or other item at a home.\", \"planned\": false}, {\"id\": \"itemevidence\", \"title\": \"Item evidence\", \"subtitle\": \"home_item_evidence\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"home_item_evidence\"], \"description\": \"Links reviewed evidence to a physical item.\", \"planned\": false}, {\"id\": \"answer\", \"title\": \"Item answer\", \"subtitle\": \"home_item_answers\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"home_item_answers\"], \"description\": \"Saved answers about an item; answers are not automatically verified property facts.\", \"planned\": false}, {\"id\": \"run\", \"title\": \"Internal agent run\", \"subtitle\": \"appliance_agent_runs\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"appliance_agent_runs\", \"agent_daily_spend\"], \"description\": \"Appliance workflow execution and budget accounting. Separate from chat and external delegation.\", \"planned\": false}, {\"id\": \"chat\", \"title\": \"Conversation\", \"subtitle\": \"chat_histories\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"chat_histories\", \"guest_chat_sessions\", \"user_document_chat_histories\", \"saved_notes\"], \"description\": \"Questions, responses and saved excerpts. Conversation history is not the canonical property truth.\", \"planned\": false}, {\"id\": \"profile\", \"title\": \"Personalisation\", \"subtitle\": \"user_profiles\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"user_profiles\", \"profile_preferences\", \"privacy_settings\", \"quiz_answers\", \"quiz_questions\", \"quiz_options\"], \"description\": \"User preferences and consent-sensitive personalisation, kept distinct from property facts.\", \"planned\": false}, {\"id\": \"partner\", \"title\": \"Partner programme\", \"subtitle\": \"partners\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"partners\", \"partner_programmes\", \"partner_campaigns\", \"partner_cohorts\", \"cohort_members\"], \"description\": \"B2B2C programmes and participation; aggregate reporting is the default boundary.\", \"planned\": false}, {\"id\": \"consent\", \"title\": \"Partner consent / access\", \"subtitle\": \"consent_records\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [\"consent_records\", \"partner_programme_accesses\", \"partner_access_audit_events\", \"partner_programme_audit_events\"], \"description\": \"Programme governance and access audit. Not a substitute for an external-agent grant.\", \"planned\": false}, {\"id\": \"grant\", \"title\": \"Delegated agent grant\", \"subtitle\": \"Conceptual / future extension\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [], \"description\": \"Roadmap: person authorises a client, home, purpose and scopes. Each read requires an active grant AND current property/document access. Revocation or lost access denies future reads.\", \"planned\": true}, {\"id\": \"maintenance\", \"title\": \"Maintenance event\", \"subtitle\": \"Conceptual / future extension\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [], \"description\": \"Domain concept; no dedicated maintenance-event table in this snapshot. Dated facts, tasks and documents can provide partial evidence.\", \"planned\": true}, {\"id\": \"compliance\", \"title\": \"Compliance record\", \"subtitle\": \"Conceptual / future extension\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [], \"description\": \"Domain concept; no dedicated compliance table. Do not infer compliance from missing evidence.\", \"planned\": true}, {\"id\": \"insight\", \"title\": \"Insight / report\", \"subtitle\": \"Conceptual / future extension\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [], \"description\": \"Generated guidance or snapshots; no dedicated insight/report persistence table in this snapshot.\", \"planned\": true}, {\"id\": \"registry\", \"title\": \"Specialist definition\", \"subtitle\": \"Conceptual / future extension\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [], \"description\": \"Version-controlled SDK registry concept. Agent definitions are not database tables; runs should pin operation revisions.\", \"planned\": true}, {\"id\": \"graph\", \"title\": \"Knowledge graph projection\", \"subtitle\": \"Conceptual / future extension\", \"badge\": \"IMPLEMENTED TABLE MAPPING\", \"mapping\": [], \"description\": \"Future derived view of relational facts and relationships. MySQL remains the source of truth; Qdrant is retrieval infrastructure, not the ontology.\", \"planned\": true}], \"edges\": [{\"source\": \"person\", \"target\": \"role\", \"label\": \"holds\", \"planned\": false}, {\"source\": \"role\", \"target\": \"property\", \"label\": \"authorises relationship to\", \"planned\": false}, {\"source\": \"property\", \"target\": \"address\", \"label\": \"has addresses\", \"planned\": false}, {\"source\": \"person\", \"target\": \"document\", \"label\": \"uploads / owns vault records\", \"planned\": false}, {\"source\": \"property\", \"target\": \"link\", \"label\": \"has document links\", \"planned\": false}, {\"source\": \"link\", \"target\": \"document\", \"label\": \"references vault document\", \"planned\": false}, {\"source\": \"link\", \"target\": \"evidence\", \"label\": \"provides source context\", \"planned\": false}, {\"source\": \"evidence\", \"target\": \"fact\", \"label\": \"supports claim\", \"planned\": false}, {\"source\": \"property\", \"target\": \"fact\", \"label\": \"has claims\", \"planned\": false}, {\"source\": \"property\", \"target\": \"task\", \"label\": \"has actions\", \"planned\": false}, {\"source\": \"property\", \"target\": \"item\", \"label\": \"contains\", \"planned\": false}, {\"source\": \"item\", \"target\": \"itemevidence\", \"label\": \"has evidence\", \"planned\": false}, {\"source\": \"itemevidence\", \"target\": \"document\", \"label\": \"references document\", \"planned\": false}, {\"source\": \"item\", \"target\": \"answer\", \"label\": \"has answers\", \"planned\": false}, {\"source\": \"run\", \"target\": \"item\", \"label\": \"operates on\", \"planned\": false}, {\"source\": \"run\", \"target\": \"itemevidence\", \"label\": \"proposes evidence for review\", \"planned\": false}, {\"source\": \"person\", \"target\": \"chat\", \"label\": \"asks questions\", \"planned\": false}, {\"source\": \"chat\", \"target\": \"document\", \"label\": \"may cite / discuss\", \"planned\": false}, {\"source\": \"person\", \"target\": \"profile\", \"label\": \"has preferences\", \"planned\": false}, {\"source\": \"person\", \"target\": \"partner\", \"label\": \"participates via cohort\", \"planned\": false}, {\"source\": \"partner\", \"target\": \"consent\", \"label\": \"governed by\", \"planned\": false}, {\"source\": \"person\", \"target\": \"consent\", \"label\": \"authorises sharing\", \"planned\": false}, {\"source\": \"person\", \"target\": \"grant\", \"label\": \"delegates\", \"planned\": true}, {\"source\": \"grant\", \"target\": \"property\", \"label\": \"scopes reads to\", \"planned\": true}, {\"source\": \"grant\", \"target\": \"role\", \"label\": \"requires current access\", \"planned\": true}, {\"source\": \"property\", \"target\": \"maintenance\", \"label\": \"records events\", \"planned\": true}, {\"source\": \"property\", \"target\": \"compliance\", \"label\": \"tracks requirements\", \"planned\": true}, {\"source\": \"fact\", \"target\": \"insight\", \"label\": \"informs\", \"planned\": true}, {\"source\": \"evidence\", \"target\": \"insight\", \"label\": \"grounds citations\", \"planned\": true}, {\"source\": \"registry\", \"target\": \"run\", \"label\": \"defines operation revision\", \"planned\": true}, {\"source\": \"fact\", \"target\": \"graph\", \"label\": \"projects into\", \"planned\": true}, {\"source\": \"role\", \"target\": \"graph\", \"label\": \"projects into\", \"planned\": true}], \"cols\": 4, \"kind\": \"concept\"};const NS='http://www.w3.org/2000/svg', svg=document.querySelector('svg'), panel=document.querySelector('aside'), search=document.querySelector('input'), scope=document.querySelector('[aria-label=\"Relationship view\"]');let selected=null,scale=1,autoFit=true;function esc(x){return String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))}function el(tag,a,text){let e=document.createElementNS(NS,tag);Object.entries(a||{}).forEach(([k,v])=>e.setAttribute(k,v));if(text)e.textContent=text;return e}const positions={};DATA.nodes.forEach((n,i)=>positions[n.id]={x:30+(i%DATA.cols)*290,y:30+Math.floor(i/DATA.cols)*125});const height=Math.ceil(DATA.nodes.length/DATA.cols)*125+30,width=DATA.cols*290+25;svg.setAttribute('viewBox',`0 0 ${width} ${height}`);function size(){const viewport=document.querySelector('.viewport');const available=Math.max(260,window.innerHeight-viewport.getBoundingClientRect().top-20);viewport.style.height=available+'px';const vb=svg.viewBox.baseVal;if(autoFit&&viewport.clientWidth>0){scale=Math.min((viewport.clientWidth-6)/vb.width,(viewport.clientHeight-6)/vb.height,1)}svg.style.width=Math.max(1,vb.width*scale)+'px';svg.style.height=Math.max(1,vb.height*scale)+'px';document.querySelector('#zoom').textContent=Math.round(scale*100)+'%'+(autoFit?' · fit':'')}let edges=el('g',{'class':'background-edges'}),nodes=el('g',{'class':'node-layer'}),foreground=el('g',{'class':'foreground-edges'}),labels=el('g',{'class':'relationship-labels'}),hoverLayer=el('g',{'class':'hover-layer'});const defs=el('defs');const marker=el('marker',{id:'arrow',viewBox:'0 0 10 10',refX:9,refY:5,markerWidth:7,markerHeight:7,orient:'auto-start-reverse'});marker.append(el('path',{d:'M 0 0 L 10 5 L 0 10 z',fill:'#12775e'}));defs.append(marker);svg.append(defs,edges,nodes,foreground,labels,hoverLayer);function placeRelationshipLabels(pending){\n for(const item of pending){\n  const label=el('text',{x:0,y:0,class:'edgeLabel','text-anchor':'start'},item.text);labels.append(label);\n  const box=label.getBBox(),w=box.width+18,h=box.height+10;\n  const r={x:item.anchor.x-w/2,y:item.anchor.y-h/2,width:w,height:h};\n  label.setAttribute('x',r.x+9-box.x);label.setAttribute('y',r.y+5-box.y);\n  const bg=el('rect',{...r,class:'edge-label-bg',rx:5});labels.insertBefore(bg,label);\n }\n size();\n}\nlet hoverSerial=0;\nfunction clearHover(){svg.classList.remove('hovering');hoverLayer.replaceChildren();for(const g of nodes.children){if(g.dataset.restClass!==undefined){g.setAttribute('class',g.dataset.restClass);delete g.dataset.restClass}}}\nfunction previewConnections(id){\n clearHover();const near=new Set([id]);DATA.edges.forEach(e=>{if(e.source===id)near.add(e.target);if(e.target===id)near.add(e.source)});\n svg.classList.add('hovering');\n for(const g of nodes.children){g.dataset.restClass=g.getAttribute('class');g.classList.remove('selected','connected','dim');g.classList.add(g.dataset.nodeId===id?'selected':near.has(g.dataset.nodeId)?'connected':'dim')}\n for(const original of svg.querySelectorAll('.background-edges .edge,.foreground-edges .edge')){\n  if(original.dataset.source!==id&&original.dataset.target!==id)continue;\n  const path=original.cloneNode(true);const pathId='hover-edge-'+(++hoverSerial);path.setAttribute('id',pathId);path.setAttribute('class','edge active');path.setAttribute('marker-end','url(#arrow)');\n  const halo=path.cloneNode(false);halo.removeAttribute('id');halo.removeAttribute('marker-end');halo.setAttribute('class','edge-halo');hoverLayer.append(halo,path);\n  const text=el('text',{'class':'hover-edge-label','text-anchor':'middle',dy:-6});\n  const textPath=el('textPath',{href:'#'+pathId,startOffset:'50%'},original.dataset.label);text.append(textPath);hoverLayer.append(text);\n }\n}\nfunction render(){clearHover();document.body.classList.toggle('has-details',!!selected);\nif(selected){\n const incoming=DATA.edges.filter(e=>e.target===selected&&e.source!==selected).map(e=>e.source);\n const outgoing=DATA.edges.filter(e=>e.source===selected&&e.target!==selected).map(e=>e.target);\n const left=[...new Set(incoming)],right=[...new Set(outgoing)].filter(x=>!left.includes(x));\n const rows=Math.max(left.length,right.length,1),h=rows*155+100;\n positions[selected]={x:700,y:h/2-45};\n left.forEach((id,i)=>positions[id]={x:30,y:50+i*155});\n right.forEach((id,i)=>positions[id]={x:1370,y:50+i*155});\n const others=DATA.nodes.filter(n=>n.id!==selected&&!left.includes(n.id)&&!right.includes(n.id));\n others.forEach((n,i)=>positions[n.id]={x:30+(i%5)*325,y:h+70+Math.floor(i/5)*125});\n const total=scope.value==='all'&&others.length?h+100+Math.ceil(others.length/5)*125:h;\n svg.setAttribute('viewBox',`0 0 1660 ${total}`);size();\n}else{DATA.nodes.forEach((n,i)=>positions[n.id]={x:30+(i%DATA.cols)*290,y:30+Math.floor(i/DATA.cols)*125});svg.setAttribute('viewBox',`0 0 ${width} ${height}`);size();}\nedges.replaceChildren();nodes.replaceChildren();foreground.replaceChildren();labels.replaceChildren();let near=new Set([selected]);DATA.edges.forEach(e=>{if(e.source===selected)near.add(e.target);if(e.target===selected)near.add(e.source)});let term=search.value.toLowerCase();const pendingLabels=[];const seen=new Set();DATA.edges.forEach(e=>{const pair=e.source+'|'+e.target;if(seen.has(pair))return;seen.add(pair);const parallel=DATA.edges.filter(x=>x.source===e.source&&x.target===e.target);const edgeText=parallel.length>1?parallel.length+' foreign keys':e.label;const a=positions[e.source],b=positions[e.target];if(!a||!b)return;const active=selected&&(e.source===selected||e.target===selected);if(scope.value==='focus'&&selected&&!active)return;let labelAnchor=null,route;\nif(active){\n const central=positions[selected],other=positions[e.source===selected?e.target:e.source];\n const isOutgoing=e.source===selected;\n if(other===central){\n  const x=central.x+127,y=central.y+90;route=`M ${x-40} ${y} V ${y+65} H ${x+40} V ${y}`;labelAnchor={x,y:y+65};\n }else{\n  const isLeft=other.x<central.x;\n  const reciprocal=DATA.edges.some(r=>r.source===e.target&&r.target===e.source);\n  const offset=reciprocal?(isOutgoing?22:-22):0;\n  const cy=central.y+45+offset,oy=other.y+45+offset;\n  const cx=isLeft?central.x:central.x+255,ox=isLeft?other.x+255:other.x;\n  const bend=isLeft?cx-35:cx+35;\n  route=isOutgoing?`M ${cx} ${cy} H ${bend} V ${oy} H ${ox}`:`M ${ox} ${oy} H ${bend} V ${cy} H ${cx}`;\n  labelAnchor={x:(bend+ox)/2,y:oy};\n }\n}else{const ax=a.x+125,ay=a.y+90,bx=b.x+125,by=b.y;route=`M ${ax} ${ay} C ${ax} ${ay+45}, ${bx} ${by-45}, ${bx} ${by}`;}\nlet path=el('path',{d:route,class:'edge'+(active?' active':selected?' unrelated':''),'marker-end':'url(#arrow)','stroke-dasharray':e.planned?'6 4':''});path.dataset.source=e.source;path.dataset.target=e.target;path.dataset.label=edgeText;path.append(el('title',{},e.source+' → '+e.target+': '+e.label));if(active){const halo=path.cloneNode(false);halo.setAttribute('class','edge-halo');halo.removeAttribute('marker-end');foreground.append(halo,path)}else{edges.append(path)}if(active){pendingLabels.push({text:edgeText,path,anchor:labelAnchor})}});DATA.nodes.forEach(n=>{if(scope.value==='focus'&&selected&&!near.has(n.id))return;let p=positions[n.id],hit=!term||JSON.stringify(n).toLowerCase().includes(term),dim=!hit||(selected&&!near.has(n.id));let g=el('g',{class:'node '+(n.planned?'planned ':'')+(selected===n.id?'selected ':selected&&near.has(n.id)?'connected ':'')+(dim?'dim':''),transform:`translate(${p.x},${p.y})`,tabindex:0,role:'button','aria-label':n.title});g.append(el('rect',{width:255,height:90,rx:10}));g.append(el('text',{x:14,y:27,'font-size':n.title.length>29?12:14,'font-weight':600},n.title));g.append(el('text',{x:14,y:50,'font-size':11},n.subtitle));g.append(el('text',{x:14,y:71,'font-size':11},n.planned?'PLANNED / NO DEDICATED TA